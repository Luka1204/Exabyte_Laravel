erDiagram
    USERS {
        bigint id PK
        varchar name
        varchar email UK
        timestamp email_verified_at "nullable"
        varchar password
        varchar remember_token "nullable"
        int token_version
        timestamp created_at
        timestamp updated_at
    }

    CATEGORIES {
        bigint id PK
        bigint company_id FK "nullable for legacy rows"
        varchar name
        text description "nullable"
        timestamp created_at
        timestamp updated_at
    }

    COMPANIES {
        bigint id PK
        varchar name
        timestamp created_at
        timestamp updated_at
    }

    COMPANY_MEMBERSHIPS {
        bigint id PK
        bigint company_id FK
        bigint user_id FK
        varchar role
        timestamp created_at
        timestamp updated_at
    }

    PLATFORM_ADMINS {
        bigint id PK
        bigint user_id FK UK
        bigint granted_by FK "nullable"
        timestamp created_at
        timestamp updated_at
    }

    SUBSCRIPTION_ACCESS_EXEMPTIONS {
        bigint id PK
        bigint company_id FK UK
        varchar reason
        timestamp expires_at "nullable"
        timestamp created_at
    }

    PLANS {
        bigint id PK
        varchar code UK
        varchar name
        text description "nullable"
        json benefits
        char currency
        decimal monthly_amount
        decimal annual_amount
        json limits
        json entitlements
        int trial_days
        int grace_days
        int terms_version
        boolean is_active
        timestamp created_at
        timestamp updated_at
    }

    SUBSCRIPTIONS {
        bigint id PK
        bigint company_id FK
        bigint billing_user_id FK
        bigint plan_id FK
        json terms_snapshot
        varchar billing_period
        varchar status
        varchar provider
        varchar provider_status "nullable"
        varchar provider_subscription_id UK "nullable"
        varchar checkout_url "nullable"
        uuid external_reference UK
        timestamp trial_ends_at "nullable"
        timestamp current_period_start "nullable"
        timestamp current_period_end "nullable"
        timestamp grace_ends_at "nullable"
        boolean cancel_at_period_end
        timestamp canceled_at "nullable"
        timestamp last_provider_event_at "nullable"
        timestamp created_at
        timestamp updated_at
    }

    PAYMENT_ATTEMPTS {
        bigint id PK
        bigint subscription_id FK
        int attempt_number
        varchar provider
        varchar kind
        varchar status
        decimal amount
        char currency
        varchar provider_invoice_id UK "nullable"
        varchar provider_payment_id UK "nullable"
        varchar provider_status "nullable"
        varchar external_reference "nullable"
        json provider_data "nullable"
        timestamp paid_at "nullable"
        timestamp created_at
        timestamp updated_at
    }

    PROVIDER_EVENTS {
        bigint id PK
        varchar provider
        varchar provider_event_id
        varchar topic
        varchar resource_id
        varchar request_id "nullable"
        json payload
        varchar processing_status
        varchar failure_code "nullable"
        timestamp processed_at "nullable"
        timestamp created_at
        timestamp updated_at
    }

    PLATFORM_AUDIT_EVENTS {
        bigint id PK
        bigint actor_user_id FK "nullable"
        varchar action
        varchar subject_type
        varchar subject_id "nullable"
        json details "nullable"
        timestamp created_at
    }

    REFRESH_TOKENS {
        bigint id PK
        bigint user_id FK
        uuid family_id "indexed"
        char token_hash UK
        int token_version
        timestamp expires_at "indexed"
        timestamp revoked_at "nullable"
        timestamp created_at
        timestamp updated_at
    }

    PASSWORD_RESET_TOKENS {
        varchar email PK
        varchar token
        timestamp created_at "nullable"
    }

    SESSIONS {
        varchar id PK
        bigint user_id "nullable, indexed, no FK"
        varchar ip_address "nullable"
        text user_agent "nullable"
        longtext payload
        int last_activity "indexed"
    }

    CACHE {
        varchar key PK
        mediumtext value
        int expiration "indexed"
    }

    CACHE_LOCKS {
        varchar key PK
        varchar owner
        int expiration "indexed"
    }

    JOBS {
        bigint id PK
        varchar queue "indexed"
        longtext payload
        tinyint attempts
        int reserved_at "nullable"
        int available_at
        int created_at
    }

    JOB_BATCHES {
        varchar id PK
        varchar name
        int total_jobs
        int pending_jobs
        int failed_jobs
        longtext failed_job_ids
        mediumtext options "nullable"
        int cancelled_at "nullable"
        int created_at
        int finished_at "nullable"
    }

    FAILED_JOBS {
        bigint id PK
        varchar uuid UK
        text connection
        text queue
        longtext payload
        longtext exception
        timestamp failed_at
    }

    COMPANIES ||--o{ COMPANY_MEMBERSHIPS : has
    USERS ||--o{ COMPANY_MEMBERSHIPS : joins
    USERS ||--o| PLATFORM_ADMINS : authorized_as
    USERS o|--o{ PLATFORM_ADMINS : grants
    COMPANIES ||--o{ SUBSCRIPTIONS : contracts
    COMPANIES ||--o| SUBSCRIPTION_ACCESS_EXEMPTIONS : legacy_access
    USERS ||--o{ SUBSCRIPTIONS : billing_owner
    PLANS ||--o{ SUBSCRIPTIONS : selected_for
    SUBSCRIPTIONS ||--o{ PAYMENT_ATTEMPTS : records
    USERS o|--o{ PLATFORM_AUDIT_EVENTS : performs
    USERS ||--o{ REFRESH_TOKENS : owns
    COMPANIES ||--o{ CATEGORIES : owns
