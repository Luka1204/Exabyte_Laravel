erDiagram
    USERS {
        bigint id PK
        varchar name
        varchar email UK
        timestamp email_verified_at "nullable"
        varchar password
        varchar remember_token "nullable"
        int token_version
        timestamp created_at
        timestamp updated_at
    }

    CATEGORIES {
        bigint id PK
        bigint company_id FK "nullable for legacy rows"
        varchar name
        text description "nullable"
        timestamp created_at
        timestamp updated_at
    }

    COMPANIES {
        bigint id PK
        varchar name
        timestamp created_at
        timestamp updated_at
    }

    COMPANY_MEMBERSHIPS {
        bigint id PK
        bigint company_id FK
        bigint user_id FK
        varchar role
        timestamp created_at
        timestamp updated_at
    }

    REFRESH_TOKENS {
        bigint id PK
        bigint user_id FK
        uuid family_id "indexed"
        char token_hash UK
        int token_version
        timestamp expires_at "indexed"
        timestamp revoked_at "nullable"
        timestamp created_at
        timestamp updated_at
    }

    PASSWORD_RESET_TOKENS {
        varchar email PK
        varchar token
        timestamp created_at "nullable"
    }

    SESSIONS {
        varchar id PK
        bigint user_id "nullable, indexed, no FK"
        varchar ip_address "nullable"
        text user_agent "nullable"
        longtext payload
        int last_activity "indexed"
    }

    CACHE {
        varchar key PK
        mediumtext value
        int expiration "indexed"
    }

    CACHE_LOCKS {
        varchar key PK
        varchar owner
        int expiration "indexed"
    }

    JOBS {
        bigint id PK
        varchar queue "indexed"
        longtext payload
        tinyint attempts
        int reserved_at "nullable"
        int available_at
        int created_at
    }

    JOB_BATCHES {
        varchar id PK
        varchar name
        int total_jobs
        int pending_jobs
        int failed_jobs
        longtext failed_job_ids
        mediumtext options "nullable"
        int cancelled_at "nullable"
        int created_at
        int finished_at "nullable"
    }

    FAILED_JOBS {
        bigint id PK
        varchar uuid UK
        text connection
        text queue
        longtext payload
        longtext exception
        timestamp failed_at
    }

    COMPANIES ||--o{ COMPANY_MEMBERSHIPS : has
    USERS ||--o{ COMPANY_MEMBERSHIPS : joins
    USERS ||--o{ REFRESH_TOKENS : owns
    COMPANIES ||--o{ CATEGORIES : owns
