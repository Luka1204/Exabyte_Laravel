classDiagram
    class AuthController {
        +login(Request, RefreshSession)
        +refresh(RefreshSessionRequest, RefreshSession)
        +me(Request)
        +logout(Request)
    }
    class AuthenticateJwt {
        +handle(Request, Closure)
    }
    class JwtTokenService {
        +issue(User, familyId) string
        +authenticate(string) AuthenticatedSession
    }
    class AuthenticatedSession {
        +user
        +familyId
    }
    class RefreshSession {
        +create(User) array
        +rotate(string) array
        +revokeFamily(string) void
    }
    class RefreshToken {
        +user_id
        +family_id
        +token_hash
        +expires_at
        +revoked_at
    }
    class User {
        +id
        +name
        +email
        +password
        +token_version
    }

    class CategoryController {
        +index(ListCategoriesRequest, ListCategories)
        +store(StoreCategoryRequest, CreateCategory)
    }
    class ListCategoriesRequest {
        +authorize() bool
        +rules() array
    }
    class StoreCategoryRequest {
        +authorize() bool
        +rules() array
        +prepareForValidation()
    }
    class ListCategories {
        +execute(int) LengthAwarePaginator
    }
    class CreateCategory {
        +execute(array) Category
    }
    class CategoryRepository {
        <<interface>>
        +paginate(int) LengthAwarePaginator
        +create(array) Category
        +existsByName(string) bool
    }
    class EloquentCategoryRepository {
        +paginate(int) LengthAwarePaginator
        +create(array) Category
        +existsByName(string) bool
    }
    class Category {
        +id
        +company_id
        +name
        +description
    }
    class CategoryPolicy {
        +viewAny(User, companyId) bool
        +create(User, companyId) bool
    }
    class RegisterAccount {
        +execute(array) UserCompany
    }
    class PlanController {
        +index() JsonResponse
        +adminIndex() JsonResponse
        +store(StorePlanRequest) JsonResponse
        +update(StorePlanRequest, plan) JsonResponse
    }
    class PlatformBillingController {
        +subscriptions(Request) JsonResponse
        +payments(Request) JsonResponse
        +metrics() JsonResponse
    }
    class StartSubscription {
        +execute(companyId, User, planId, billingPeriod) Subscription
    }
    class CancelSubscription {
        +execute(companyId, billingUserId) Subscription
    }
    class SubscriptionLifecycle {
        +transition(Subscription, targetStatus) void
    }
    class SubscriptionAccess {
        +featureDenial(companyId, entitlement) array|null
        +assertProductLimit(companyId) void
    }
    class RequireSubscriptionEntitlement {
        +handle(Request, Closure, entitlement) Response
    }
    class MercadoPagoGateway {
        <<interface>>
        +createPendingPreapproval(array) array
        +findPreapprovalByReference(reference) array
        +findAuthorizedPayment(paymentId) array
        +cancelPreapproval(id) void
    }
    class MercadoPagoSdkGateway {
        +createPendingPreapproval(array) array
        +findPreapprovalByReference(reference) array
        +findAuthorizedPayment(paymentId) array
        +cancelPreapproval(id) void
    }
    class MercadoPagoWebhookController {
        +__invoke(Request) Response
    }
    class ProcessMercadoPagoEvent {
        +handle(MercadoPagoGateway) void
    }
    class RequirePlatformAdmin {
        +handle(Request, Closure) Response
    }
    class Plan {
        +id
        +code
        +monthly_amount
        +annual_amount
        +limits
        +entitlements
        +terms_version
        +is_active
    }
    class Subscription {
        +company_id
        +billing_user_id
        +plan_id
        +terms_snapshot
        +status
        +provider_status
        +external_reference
    }
    class PaymentAttempt {
        +subscription_id
        +attempt_number
        +kind
        +status
        +amount
        +provider_invoice_id
        +provider_payment_id
    }
    class ProviderEvent {
        +provider_event_id
        +topic
        +resource_id
        +processing_status
    }
    class PlatformAuditEvent {
        +actor_user_id
        +action
        +subject_type
        +subject_id
    }
    class PlatformAdmin {
        +user_id
        +granted_by
    }
    class SubscriptionAccessExemption {
        +company_id
        +reason
        +expires_at
    }
    class CatalogServiceProvider {
        +register()
    }
    class CompanyController {
        +index(Request) JsonResponse
        +store(StoreCompanyRequest, CreateCompany) JsonResponse
    }
    class CreateCompany {
        +execute(User, string) Company
    }
    class RequireCompanyMembership {
        +handle(Request, Closure) Response
    }
    class Company {
        +id
        +name
        +memberships()
    }

    AuthController --> JwtTokenService : issues access token
    AuthController --> RefreshSession : creates and rotates token families
    RefreshSession --> RefreshToken : persists token hashes
    RefreshSession --> JwtTokenService : issues session-bound access tokens
    AuthenticateJwt --> JwtTokenService : validates bearer token
    JwtTokenService --> User : loads and checks token_version
    JwtTokenService --> RefreshToken : requires an active session family
    JwtTokenService --> AuthenticatedSession : returns user and family id
    RefreshToken --> User : belongs to
    CategoryController --> ListCategories
    CategoryController --> CreateCategory
    CategoryController ..> ListCategoriesRequest : validates
    CategoryController ..> StoreCategoryRequest : validates
    ListCategories --> CategoryRepository
    CreateCategory --> CategoryRepository
    EloquentCategoryRepository ..|> CategoryRepository
    EloquentCategoryRepository --> Category : Eloquent persistence
    CatalogServiceProvider ..> CategoryRepository : binds implementation
    CompanyController --> CreateCompany
    CompanyController --> Company : lists user memberships
    RequireCompanyMembership --> User : verifies membership
    RequireCompanyMembership --> Company : resolves selected company
    Category --> Company : belongs to
    CategoryController --> CategoryPolicy : authorizes company role
    CategoryPolicy --> User : checks membership and role
    CreateCompany --> Company : transactionally creates
    Company --> User : memberships
    AuthController --> RegisterAccount : registers account
    PlanController --> Plan : manages offers
    PlanController --> PlatformAuditEvent : audits changes
    PlatformBillingController --> Subscription : reads contracts
    PlatformBillingController --> PaymentAttempt : reads payment history
    PlatformBillingController --> Plan : aggregates distribution
    RequirePlatformAdmin --> PlatformAdmin : verifies platform authorization
    RequireSubscriptionEntitlement --> SubscriptionAccess : checks feature access
    SubscriptionAccess --> Subscription : resolves current contractual terms
    SubscriptionAccess --> SubscriptionAccessExemption : preserves legacy access
    SubscriptionAccess --> Product : enforces product count transactionally
    StartSubscription --> MercadoPagoGateway : creates/recovers hosted checkout
    StartSubscription --> Subscription : snapshots commercial terms
    StartSubscription --> PaymentAttempt : records initial attempt
    MercadoPagoSdkGateway ..|> MercadoPagoGateway
    MercadoPagoWebhookController --> ProviderEvent : validates, persists, deduplicates
    MercadoPagoWebhookController --> ProcessMercadoPagoEvent : enqueues event
    ProcessMercadoPagoEvent --> MercadoPagoGateway : verifies provider state
    ProcessMercadoPagoEvent --> SubscriptionLifecycle : validates state transitions
    ProcessMercadoPagoEvent --> PaymentAttempt : records verified operations
    ProcessMercadoPagoEvent --> ProviderEvent : records processing result
    Subscription --> Plan : references catalog plan
    Subscription --> Company : belongs to billing tenant
    Subscription --> User : billing owner
    Subscription --> PaymentAttempt : has immutable attempt history
